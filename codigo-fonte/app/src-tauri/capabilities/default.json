{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "updater:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/nahtan17/FM-EVOLUTION-PRO-27/*" },
        { "url": "https://github.com/tozmoz/FMLibreEditor/*" }
      ]
    }
  ]
}
